{
  "schemaVersion": 1,
  "id": "yuchayuan_buildsharer",
  "version": "${version}",
  "name": "YuChaYuan BuildSharer",
  "description": "Turns your current Wynncraft character into a WynnBuilder link: skill points, ability tree, equipped and crafted gear.",
  "authors": [
    "LyuChaCha"
  ],
  "license": "AGPL-3.0-or-later",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.yuchayuan.buildsharer.fabric.BuildSharerFabric"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "wynntils": ">=4.2.0 <5.0.0-"
  },
  "suggests": {
    "wynnchayuan": "*"
  }
}
